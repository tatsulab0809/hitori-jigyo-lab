---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articles } from "../data/articles.js";
import { affiliatePrograms } from "../data/affiliate/programs.js";

const featuredArticles = [
  {
    title: "ひとり事業ツール診断",
    label: "診断",
    description: "目的と悩みから、海外AI/SaaSや国内ツールの候補を整理します。",
    href: "/diagnosis/",
    image: "/images/eyecatch-tool-diagnosis-comic.png"
  },
  {
    title: "海外SaaSを使う前に",
    label: "海外SaaS",
    description: "英語UI、支払い、解約、円換算など、登録前に見るポイントをまとめます。",
    href: "/overseas-saas/",
    image: "/images/eyecatch-overseas-saas-comic.png"
  },
  {
    title: "ツール比較ハブ",
    label: "比較",
    description: "AI、Web制作、EC、ニュースレター、会計まわりの道具を用途別に見ます。",
    href: "/tools/",
    image: "/images/eyecatch-tool-comparison-comic.png"
  }
];

const recentArticles = articles.slice(0, 3);
const starterArticles = articles.filter((article) =>
  [
    "/articles/webflow-free-plan-hands-on/",
    "/articles/kit-newsletter-before-start/",
    "/articles/beehiiv-japanese-newsletter-test/",
    "/articles/partnerstack-application-log/",
    "/articles/impact-declined-learning-plan/"
  ].includes(article.href)
);

const toolRoutes = [
  {
    title: "Webサイトを作りたい",
    description: "Webflowを中心に、無料プランで試せること、WordPressやAstroとの違い、公開後の運用まで確認します。",
    href: "/tools/#website-picks",
    cta: "Web制作ツールを見る"
  },
  {
    title: "読者リストを育てたい",
    description: "Kitとbeehiivを、日本語ニュースレター、登録フォーム、配信頻度、料金の目線で比べます。",
    href: "/tools/#newsletter-picks",
    cta: "ニュースレターを見る"
  },
  {
    title: "海外ASPに挑戦したい",
    description: "PartnerStackの申請実録とimpact.com却下の学びから、審査前に整える情報を整理します。",
    href: "/affiliate-programs/",
    cta: "申請状況を見る"
  },
  {
    title: "更新を追いかけたい",
    description: "ニュースレター準備ページと実験ログで、サイト改善や申請の進み方を時系列で見られます。",
    href: "/newsletter/",
    cta: "ニュースレターを見る"
  }
];

const priorityPrograms = affiliatePrograms.filter((program) =>
  ["webflow", "kit", "beehiiv"].includes(program.slug)
);

const siteStats = [
  {
    value: articles.length,
    label: "公開記事",
    description: "実験ログ、個別レビュー、比較前の確認記事を積み上げ中"
  },
  {
    value: "5",
    label: "比較ページ",
    description: "ニュースレター、Web制作、CRM、画像制作、解析を用途別に整理"
  },
  {
    value: affiliatePrograms.length,
    label: "追跡中プログラム",
    description: "海外ASPと直申請候補をステータス付きで管理"
  },
  {
    value: "2",
    label: "申請ログ",
    description: "PartnerStackとimpact.comの申請・改善過程を公開記録"
  }
];
---

<BaseLayout>
  <section class="intro">
    <p class="eyebrow">AI / SaaS / Solo Business Lab</p>
    <h1>AIと海外SaaSで、ひとり事業を小さく作る実験室</h1>
    <p>
      TATSUがCodex、海外AIツール、Web制作サービス、発信ツールを実際に試しながら、
      日本の個人事業主や副業者にとって本当に使えるかを記録します。
    </p>
  </section>

  <section class="section compact">
    <div class="lab-panel">
      <div>
        <p class="panel-label">Current Focus</p>
        <h2>海外ツールを「日本で使える道具」に翻訳する</h2>
        <p>
          料金、無料プラン、日本語対応、支払い、解約、ChatGPTやCodexで代替できるか。
          ひとりで事業を作る人が迷いやすいところから検証します。
        </p>
      </div>
      <a class="button primary" href="/overseas-saas/">海外SaaS入門へ</a>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>運営実績</h2>
    </div>
    <div class="media-proof-grid">
      {siteStats.map((stat) => (
        <article class="media-proof-card">
          <strong>{stat.value}</strong>
          <h3>{stat.label}</h3>
          <p>{stat.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>まず読む5本</h2>
    </div>
    <div class="starter-reading-grid">
      {starterArticles.map((article, index) => (
        <a class="starter-card" href={article.href}>
          <img src={article.image} alt="" />
          <div>
            <p>{String(index + 1).padStart(2, "0")} / {article.category}</p>
            <h3>{article.title}</h3>
            <span>この記事を読む</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="conversion-band">
      <div>
        <p class="panel-label">Start Here</p>
        <h2>迷ったら、目的から道具を選ぶ</h2>
        <p>
          ひとり事業の道具選びは、評判よりも「いま何を前に進めたいか」で決めた方が失敗しにくいです。
          いきなり全部契約すると、翌月のカード明細が小さな会議を開きます。
        </p>
      </div>
      <div class="route-grid">
        {toolRoutes.map((route) => (
          <a class="route-card" href={route.href}>
            <h3>{route.title}</h3>
            <p>{route.description}</p>
            <span>{route.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="partner-appeal">
      <div>
        <p class="panel-label">For Reviewers</p>
        <h2>提携審査で確認しやすい情報を公開しています</h2>
        <p>
          媒体概要、レビュー基準、アフィリエイト開示、申請ログを分けて公開しています。
          まだ小さな媒体ですが、読者に誤解を与えない紹介方針と、改善過程の透明性を重視しています。
        </p>
      </div>
      <div class="button-row">
        <a class="button primary" href="/for-partners/">媒体概要</a>
        <a class="button" href="/review-policy/">レビュー基準</a>
        <a class="button" href="/affiliate-disclosure/">広告リンクの開示</a>
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>収益導線の中心ツール</h2>
    </div>
    <div class="program-strip">
      {priorityPrograms.map((program) => (
        <article class="program-mini-card">
          <p>{program.category}</p>
          <h3>{program.name}</h3>
          <span class={`status-pill ${program.status}`}>{program.status === "to_apply" ? "申請予定" : program.status}</span>
          <a class="button primary" href={`/go/${program.slug}/`}>公式ページへ</a>
        </article>
      ))}
    </div>
  </section>

  <section class="featured-grid" aria-label="Featured articles">
    {featuredArticles.map((article) => (
      <a class="feature-card" href={article.href}>
        <div class={`feature-visual ${article.label === "設計" ? "gold" : article.label === "実験" ? "navy" : ""}`}>
          <img src={article.image} alt="" />
        </div>
        <div class="feature-body">
          <p>{article.label}</p>
          <h2>{article.title}</h2>
          <span class="read-more">READ MORE</span>
        </div>
      </a>
    ))}
  </section>

  <section class="content-layout">
    <div>
      <article class="latest-post">
        <p class="post-date">2026/06/05</p>
        <h2>Codexと一緒にサイト公開まで進めた記録</h2>
        <p class="post-category">副業実験ログ</p>
        <div class="post-image">
          <img src="/images/eyecatch-codex-launch.svg" alt="" />
        </div>
      <p>
          サイト制作そのものはCodexに任せつつ、GitHub、Cloudflare、独自ドメイン設定は自分の手で進めました。
          スクショを見せながら相談して、hitori-jigyo-lab.comでの公開までたどり着いた実験ログです。
      </p>
        <a class="button primary" href="/articles/codex-site-launch-record/">この記事を読む</a>
      </article>

      <section class="article-list">
        <div class="section-title">
          <h2>新着記事</h2>
        </div>
        {recentArticles.map((article) => (
          <a class="list-card" href={article.href}>
            <div class="list-thumb navy">
              <img src={article.image} alt="" />
            </div>
            <div>
              <p>{article.category}</p>
              <h3>{article.title}</h3>
              <span>この記事を読む</span>
            </div>
          </a>
        ))}
      </section>
    </div>

    <aside class="sidebar">
      <section class="profile-box">
        <img class="profile-photo" src="/images/tatsu-profile.png" alt="TATSUのプロフィール写真" />
        <h2>TATSU</h2>
        <p>福岡県在住。17年間、外壁塗装の現場と事業運営に向き合ってきた昭和生まれの事業主です。</p>
        <p>事業主にとって時間は宝。現場で培った判断力と実務感覚をもとに、AIやWebツールを使って小さな事業を育てる方法を実験しています。</p>
        <a href="/operator/">プロフィール詳細</a>
      </section>

      <section class="side-box">
        <h2>カテゴリ</h2>
        <div class="side-links">
          <a href="/diagnosis/">ひとり事業ツール診断</a>
          <a href="/tools/">ツール比較ハブ</a>
          <a href="/overseas-saas/">海外SaaS入門</a>
          <a href="/categories/experiment-log/">事業実験ログ</a>
          <a href="/categories/workspace/">作業環境</a>
        </div>
      </section>
    </aside>
  </section>
</BaseLayout>
