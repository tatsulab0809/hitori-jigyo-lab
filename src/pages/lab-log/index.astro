---
import BaseLayout from "../../layouts/BaseLayout.astro";

const timeline = [
  {
    date: "2026-06",
    title: "サイト公開",
    description: "Astro、GitHub、Cloudflare Pagesで、ひとり事業ラボを公開。"
  },
  {
    date: "2026-08-26",
    title: "海外SaaSアフィリエイトへ方向転換",
    description: "AI、Web制作、ニュースレター、海外SaaSの実験メディアとして導線を整理。"
  },
  {
    date: "2026-08-26",
    title: "PartnerStackへ申請",
    description: "ネットワークプロフィールを作成し、媒体説明と販売チャネルを登録。現在は審査待ち。"
  },
  {
    date: "2026-08-26",
    title: "impact.comは却下",
    description: "即時却下を受け、記事数、運営者情報、申請に耐える実体験コンテンツを強化。"
  },
  {
    date: "2026-08-26",
    title: "サイト強化を継続",
    description: "比較記事、チェックリスト、ニュースレター導線、実験ログページを追加。"
  },
  {
    date: "2026-08-27",
    title: "媒体の信頼ページを追加",
    description: "運営者情報、編集方針、レビュー基準、アフィリエイト表記、英語媒体説明ページを整備。"
  },
  {
    date: "2026-08-27",
    title: "Xアカウントを整備",
    description: "@hitorijigyolabのプロフィール、サイトリンク、アイコン、初投稿、固定ポストを設定。日々の公開実験ログとして運用開始。"
  },
  {
    date: "2026-08-27",
    title: "再申請前の媒体導線を強化",
    description: "トップページからX、実験ログ、メディアキットへ進める導線を追加し、審査担当が運営実態を確認しやすい構成へ更新。"
  }
];

const currentSignals = [
  {
    label: "Publishing",
    title: "長文記事を継続追加",
    description: "AI、海外SaaS、Web制作、CRM、ニュースレター、解析などの実務記事を増やしています。"
  },
  {
    label: "Social",
    title: "Xで日々の実験を発信",
    description: "完成した成功談ではなく、申請、改善、失敗、次の一手を短いログとして投稿します。"
  },
  {
    label: "Review",
    title: "海外ASP再申請に向けて整備",
    description: "媒体概要、レビュー基準、開示、運営者プロフィール、申請用英文をそろえています。"
  }
];
---

<BaseLayout
  title="実験ログ | ひとり事業ラボ"
  description="ひとり事業ラボの運営・申請・改善の流れを時系列でまとめる実験ログページです。"
>
  <section class="page-heading">
    <p class="eyebrow">Lab Log</p>
    <h1>ひとり事業ラボの実験ログ</h1>
    <p>
      サイト公開、海外SaaSアフィリエイト申請、却下、改善、記事追加。
      うまくいったことだけでなく、途中の判断も残します。
    </p>
  </section>

  <section class="section compact">
    <div class="wide-visual">
      <img src="/images/eyecatch-lab-log-first-steps-comic.png" alt="作業場の床に広げた長いタイムラインにサイト運営の節目を並べる漫画調イラスト" />
    </div>
  </section>

  <section class="section compact">
    <div class="lab-panel">
      <div>
        <p class="panel-label">Why Log?</p>
        <h2>これは成功談ではなく、進行中の作業記録です</h2>
        <p>
          ひとり事業は、きれいな計画よりも小さな改善の積み重ねで進みます。
          申請に落ちたことも、導線を直したことも、あとで使える判断材料として残します。
        </p>
      </div>
      <p class="button-row">
        <a class="button primary" href="/articles/first-steps-overseas-saas-affiliate-log/">最初にやったことを読む</a>
        <a class="button" href="/monthly-log/">月次運営ログを見る</a>
      </p>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>現在の運営シグナル</h2>
    </div>
    <div class="trust-summary">
      {currentSignals.map((signal) => (
        <article>
          <p class="panel-label">{signal.label}</p>
          <h2>{signal.title}</h2>
          <p>{signal.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>時系列ログ</h2>
    </div>
    <div class="timeline-list">
      {timeline.map((item) => (
        <article class="timeline-item">
          <time>{item.date}</time>
          <div>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="decision-grid">
      <article class="decision-card">
        <p class="panel-label">Try</p>
        <h2>試す</h2>
        <p>海外SaaS、AI、Web制作ツールを、小さな作業単位で触ります。</p>
      </article>
      <article class="decision-card">
        <p class="panel-label">Write</p>
        <h2>書く</h2>
        <p>試したこと、迷ったこと、申請の結果を記事として残します。</p>
      </article>
      <article class="decision-card">
        <p class="panel-label">Improve</p>
        <h2>直す</h2>
        <p>トップ、ツールページ、運営者情報、導線を少しずつ改善します。</p>
      </article>
    </div>
  </section>

  <section class="section compact">
    <div class="cta-box">
      <p class="panel-label">Live Channel</p>
      <h2>Xでも実験ログを発信しています</h2>
      <p>
        サイト側には整理した記事を、X側には日々の短い作業ログを残します。
        申請に落ちたことも、プロフィールを直したことも、次の改善に使える材料として公開します。
      </p>
      <p class="button-row">
        <a class="button primary" href="https://x.com/hitorijigyolab">Xを見る</a>
        <a class="button" href="/media-kit/">申請用メディアキットを見る</a>
        <a class="button" href="/for-partners/">For Partnersを見る</a>
      </p>
    </div>
  </section>
</BaseLayout>
