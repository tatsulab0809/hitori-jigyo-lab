---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { affiliatePrograms } from "../../data/affiliate/programs.js";

const programBySlug = Object.fromEntries(affiliatePrograms.map((program) => [program.slug, program]));

const websitePicks = [
  {
    slug: "webflow",
    name: "Webflow",
    role: "見た目と更新性を両立したい人向け",
    bestFor: "サービス紹介サイト、LP、ポートフォリオ",
    freePlan: "無料で操作感を確認しやすい",
    japaneseFit: "日本語表示は扱えるが、管理画面は英語中心",
    article: "/articles/webflow-wordpress-astro-comparison/",
    articleLabel: "3ツール比較を読む"
  },
  {
    slug: "wordpress",
    name: "WordPress",
    role: "検索流入を長く育てたい人向け",
    bestFor: "ブログ、事例記事、地域ビジネスサイト",
    freePlan: "サーバー代やテーマ代が別途かかりやすい",
    japaneseFit: "日本語情報が多く、外注もしやすい",
    article: "/articles/webflow-wordpress-astro-comparison/",
    articleLabel: "3ツール比較を読む"
  },
  {
    slug: "astro",
    name: "Astro",
    role: "軽い静的サイトを自分で育てたい人向け",
    bestFor: "実験サイト、記事サイト、小さなメディア",
    freePlan: "GitHubとCloudflare Pagesで小さく始めやすい",
    japaneseFit: "制作には少し技術理解が必要",
    article: "/articles/webflow-wordpress-astro-comparison/",
    articleLabel: "3ツール比較を読む"
  }
];

const newsletterPicks = [
  {
    slug: "kit",
    name: "Kit",
    role: "少人数の濃い読者リストを育てたい人向け",
    bestFor: "個人発信、講座、サービス案内、ステップメール",
    freePlan: "最初の検証に使いやすい",
    japaneseFit: "英語UI前提。読者向け文章は日本語で組める",
    article: "/articles/kit-beehiiv-starting-comparison/",
    articleLabel: "始め方比較を読む"
  },
  {
    slug: "beehiiv",
    name: "beehiiv",
    role: "メディア型ニュースレターを育てたい人向け",
    bestFor: "定期配信、スポンサー導線、読者増加施策",
    freePlan: "日本語運用は事前確認したい",
    japaneseFit: "英語UI中心。登録フォームや表示確認が大事",
    article: "/articles/kit-beehiiv-starting-comparison/",
    articleLabel: "始め方比較を読む"
  },
  {
    slug: "substack",
    name: "Substack",
    role: "文章中心でまず配信を始めたい人向け",
    bestFor: "エッセイ、コラム、ゆるい読者コミュニティ",
    freePlan: "始めやすいが収益導線は別設計が必要",
    japaneseFit: "日本語投稿は可能。細かな導線設計は弱め",
    article: "/articles/beehiiv-vs-kit-japanese-solo-business/",
    articleLabel: "Kit/beehiiv比較を見る"
  }
];

const laterPicks = [
  {
    slug: "hubspot",
    name: "HubSpot",
    timing: "問い合わせ管理が増えてから",
    note: "無料CRMから入れるので、顧客管理の記事が増えた段階で導線化しやすい。",
    article: "/articles/hubspot-free-crm-solo-business/"
  },
  {
    slug: "shopify",
    name: "Shopify",
    timing: "商品やデジタル販売の実験後",
    note: "ECの文脈が必要。いきなり薦めるより、小さな販売実験の記事を作ってから。",
    article: "/articles/shopify-small-product-sales-before-start/"
  },
  {
    slug: "canva",
    name: "Canva",
    timing: "記事画像の型を作る段階",
    note: "アイキャッチや図解を増やすほど、独自性と読みやすさの基準が必要になる。",
    article: "/articles/canva-affiliate-article-image-workflow/"
  },
  {
    slug: "notion",
    name: "Notion",
    timing: "作業メモが散らかり始めたら",
    note: "記事案、ツール調査、申請メモをまとめる作業台として使えるが、入れすぎには注意。",
    article: "/articles/notion-solo-business-workspace-limits/"
  },
  {
    slug: "semrush",
    name: "Semrush",
    timing: "SEO記事が増えてから",
    note: "高機能だが初心者には重い。検索流入の検証ログとセットで扱う。",
    article: "/articles/analytics-search-console-before-setup/"
  }
];

const useCaseGroups = [
  {
    title: "サイト制作",
    description: "サービス紹介、記事メディア、LPを作る道具。Webflow、WordPress、Astroを比較します。",
    href: "/compare/website-tools/"
  },
  {
    title: "ニュースレター",
    description: "読者リストを作る道具。Kit、beehiiv、Substackを用途別に見ます。",
    href: "/compare/newsletter-tools/"
  },
  {
    title: "CRM・顧客管理",
    description: "問い合わせや見込み客を整理する道具。まずはHubSpot無料CRMから確認します。",
    href: "/articles/hubspot-free-crm-solo-business/"
  },
  {
    title: "画像制作",
    description: "記事のアイキャッチや図解を作る道具。CanvaとAI画像生成の使い分けを考えます。",
    href: "/articles/canva-affiliate-article-image-workflow/"
  },
  {
    title: "アクセス解析",
    description: "Google AnalyticsとSearch Consoleを入れる前に、何を見たいかを決めます。",
    href: "/articles/analytics-search-console-before-setup/"
  },
  {
    title: "小さなEC",
    description: "Shopifyなどで商品販売を始める前に、商品、配送、返品、決済を確認します。",
    href: "/articles/shopify-small-product-sales-before-start/"
  }
];

const getProgram = (slug) => programBySlug[slug];

const statusLabel = {
  to_apply: "申請予定",
  submitted: "審査中",
  declined: "見送り中",
  approved: "承認済み"
};
---

<BaseLayout
  title="ツール比較ハブ | ひとり事業ラボ"
  description="ひとり事業に使うAIツール、海外SaaS、Web制作、EC、ニュースレター、会計ツールを用途別に整理します。"
>
  <section class="page-heading">
    <p class="eyebrow">Tool Comparison</p>
    <h1>ツール比較ハブ</h1>
    <p>
      ここでは「有名だから」ではなく、ひとり事業で本当に使う場面があるかを基準に道具を整理します。
      実際に試したものから、料金、使いやすさ、つまずきやすさを追記していきます。
    </p>
  </section>

  <section class="section compact">
    <div class="wide-visual">
      <img src="/images/eyecatch-tool-comparison-comic.png" alt="ひとり事業に使うツールを4コマ漫画調で比較しているイラスト" />
    </div>
  </section>

  <section class="section compact">
    <div class="lab-panel">
      <div>
        <p class="panel-label">Affiliate Operation</p>
        <h2>紹介リンクは一箇所で管理します</h2>
        <p>海外SaaSは承認状況や条件が変わりやすいので、記事ごとに直書きせず、紹介プログラム一覧と出口ページで管理します。</p>
      </div>
      <p class="button-row">
        <a class="button primary" href="/affiliate-programs/">紹介プログラム一覧</a>
        <a class="button" href="/compare/">比較ページ一覧</a>
      </p>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>用途別に探す</h2>
    </div>
    <div class="route-grid">
      {useCaseGroups.map((group) => (
        <a class="tool-route-card" href={group.href}>
          <p class="panel-label">Use Case</p>
          <h2>{group.title}</h2>
          <p>{group.description}</p>
          <span>見る</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>最初に見るおすすめルート</h2>
    </div>
    <div class="tool-route-grid">
      <a class="tool-route-card" href="#website-picks">
        <p class="panel-label">Website</p>
        <h2>ホームページを作る</h2>
        <p>まずはWebflow、WordPress、Astroのどれで作るか。見た目、更新、費用、自由度を比べます。</p>
        <span>Web制作ツールへ</span>
      </a>
      <a class="tool-route-card" href="#newsletter-picks">
        <p class="panel-label">Newsletter</p>
        <h2>読者リストを作る</h2>
        <p>Kitとbeehiivを中心に、SEOだけに頼らない発信導線を作ります。読者0人からの話です。静かで好きです。</p>
        <span>発信ツールへ</span>
      </a>
      <a class="tool-route-card" href="#later-picks">
        <p class="panel-label">Later</p>
        <h2>後で検討する</h2>
        <p>CRM、EC、SEO専用ツールは強いですが、最初から全部入れると管理画面だけで朝になります。</p>
        <span>次候補を見る</span>
      </a>
    </div>
  </section>

  <section id="website-picks" class="section compact">
    <div class="section-title">
      <h2>Web制作ツール</h2>
    </div>
    <div class="comparison-table">
      {websitePicks.map((tool) => {
        const program = getProgram(tool.slug);
        return (
          <article class="comparison-card">
            <div class="comparison-head">
              <div>
                <p class="panel-label">{tool.bestFor}</p>
                <h2>{tool.name}</h2>
              </div>
              {program && <span class={`status-pill ${program.status}`}>{statusLabel[program.status] ?? program.status}</span>}
            </div>
            <p>{tool.role}</p>
            <dl>
              <div>
                <dt>無料確認</dt>
                <dd>{tool.freePlan}</dd>
              </div>
              <div>
                <dt>日本語運用</dt>
                <dd>{tool.japaneseFit}</dd>
              </div>
            </dl>
            <div class="button-row">
              <a class="button" href={tool.article}>{tool.articleLabel}</a>
              {program && <a class="button primary" href={`/go/${program.slug}/`}>公式ページへ</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="newsletter-picks" class="section compact">
    <div class="section-title">
      <h2>ニュースレター・発信ツール</h2>
    </div>
    <div class="comparison-table">
      {newsletterPicks.map((tool) => {
        const program = getProgram(tool.slug);
        return (
          <article class="comparison-card">
            <div class="comparison-head">
              <div>
                <p class="panel-label">{tool.bestFor}</p>
                <h2>{tool.name}</h2>
              </div>
              {program && <span class={`status-pill ${program.status}`}>{statusLabel[program.status] ?? program.status}</span>}
            </div>
            <p>{tool.role}</p>
            <dl>
              <div>
                <dt>無料確認</dt>
                <dd>{tool.freePlan}</dd>
              </div>
              <div>
                <dt>日本語運用</dt>
                <dd>{tool.japaneseFit}</dd>
              </div>
            </dl>
            <div class="button-row">
              <a class="button" href={tool.article}>{tool.articleLabel}</a>
              {program && <a class="button primary" href={`/go/${program.slug}/`}>公式ページへ</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="later-picks" class="section compact">
    <div class="section-title">
      <h2>次に育てる候補</h2>
    </div>
    <div class="later-tool-grid">
      {laterPicks.map((tool) => {
        const program = getProgram(tool.slug);
        return (
          <article class="later-tool-card">
            <p class="panel-label">{tool.timing}</p>
            <h2>{tool.name}</h2>
            <p>{tool.note}</p>
            {tool.article && <a class="button" href={tool.article}>レビュー記事を読む</a>}
            {program && <a class="button" href={`/go/${program.slug}/`}>公式ページを確認</a>}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section compact">
    <div class="tool-stack">
      <article id="ai" class="tool-row">
        <div>
          <p class="panel-label">AI</p>
          <h2>AIツール</h2>
        </div>
        <p>文章、調査、画像、文字起こし、動画、業務自動化。ChatGPTやCodexで足りる部分と、専用ツールが必要な部分を分けます。</p>
      </article>
      <article id="website" class="tool-row">
        <div>
          <p class="panel-label">Website</p>
          <h2>Web制作</h2>
        </div>
        <p>Astro、WordPress、Webflow、Framer、Carrdなど。自作、外注、AI併用のどれが現実的かを見ます。まずは <a href="/articles/webflow-for-japanese-solo-business/">Webflowの記事</a> から整理します。</p>
      </article>
      <article id="commerce" class="tool-row">
        <div>
          <p class="panel-label">Commerce</p>
          <h2>EC・決済</h2>
        </div>
        <p>Shopify、決済リンク、予約、フォーム、デジタル商品販売。小さく売り始める導線を検証します。</p>
      </article>
      <article id="newsletter" class="tool-row">
        <div>
          <p class="panel-label">Audience</p>
          <h2>ニュースレター・発信</h2>
        </div>
        <p>beehiiv、Kit、Substack、note、X。SEOだけを待たず、読者との接点を作る道具を比較します。最初の比較は <a href="/articles/beehiiv-vs-kit-japanese-solo-business/">beehiivとKitの記事</a> です。</p>
      </article>
      <article id="backoffice" class="tool-row">
        <div>
          <p class="panel-label">Back Office</p>
          <h2>会計・書類</h2>
        </div>
        <p>会計ソフト、請求書、見積もり、報告書テンプレート。地味だけど時間を守る領域です。</p>
      </article>
    </div>
  </section>
</BaseLayout>
