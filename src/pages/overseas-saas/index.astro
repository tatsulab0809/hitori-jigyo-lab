---
import BaseLayout from "../../layouts/BaseLayout.astro";

const readingRoutes = [
  {
    label: "Step 01",
    title: "海外SaaSを使う前の基本確認",
    description: "料金、支払い、解約、日本語対応、サポートを先に確認します。",
    href: "/articles/overseas-saas-before-use/"
  },
  {
    label: "Step 02",
    title: "支払い・解約チェックリスト",
    description: "無料トライアルやドル建て課金で迷わないための確認項目です。",
    href: "/articles/overseas-saas-payment-cancel-checklist/"
  },
  {
    label: "Step 03",
    title: "ASP申請前チェック",
    description: "PartnerStackやimpact.comに出す前に、媒体説明と導線を整えます。",
    href: "/articles/partnerstack-impact-application-checklist/"
  },
  {
    label: "Step 04",
    title: "申請ログと改善記録",
    description: "申請、却下、LinkedIn改善、サイト強化を実験ログとして残します。",
    href: "/articles/partnerstack-linkedin-profile-improvement/"
  }
];

const reviewRoutes = [
  {
    title: "Web制作",
    description: "Webflow、WordPress、Astroを比較し、小さな事業サイトの作り方を考えます。",
    href: "/articles/webflow-wordpress-astro-comparison/"
  },
  {
    title: "ニュースレター",
    description: "Kitとbeehiivを中心に、日本語で読者リストを作る方法を整理します。",
    href: "/articles/kit-beehiiv-starting-comparison/"
  },
  {
    title: "CRM",
    description: "HubSpot無料CRMを、問い合わせ管理や見込み客管理の視点で確認します。",
    href: "/articles/hubspot-free-crm-solo-business/"
  },
  {
    title: "EC",
    description: "Shopifyを小さな商品販売で使う前に、商品、決済、配送、返品を確認します。",
    href: "/articles/shopify-small-product-sales-before-start/"
  }
];
---

<BaseLayout
  title="海外SaaS入門 | ひとり事業ラボ"
  description="海外SaaSを日本の個人事業主が使う前に確認したい、料金、日本語対応、支払い、解約、アフィリエイト導線の考え方をまとめます。"
>
  <section class="page-heading">
    <p class="eyebrow">Overseas SaaS</p>
    <h1>海外SaaSを日本のひとり事業で使う前に</h1>
    <p>
      海外ツールは報酬条件も機能も魅力的ですが、英語UI、支払い、解約、税務フォーム、サポートの不安があります。
      ひとり事業ラボでは、その不安を一つずつ実験ログにしていきます。
    </p>
  </section>

  <section class="section compact">
    <div class="wide-visual">
      <img src="/images/eyecatch-overseas-saas-comic.png" alt="海外SaaSの登録や支払いを4コマ漫画調で確認しているイラスト" />
    </div>
  </section>

  <section class="section compact">
    <div class="overseas-grid">
      <article class="decision-card">
        <p class="panel-label">Check 01</p>
        <h2>日本語で使えるか</h2>
        <p>管理画面が英語でも、日本語入力や日本語の公開ページに問題がなければ使える可能性があります。</p>
      </article>
      <article class="decision-card">
        <p class="panel-label">Check 02</p>
        <h2>支払いと解約</h2>
        <p>無料トライアル後の課金、返金条件、解約場所、PayPalやカード対応を先に確認します。</p>
      </article>
      <article class="decision-card">
        <p class="panel-label">Check 03</p>
        <h2>本当に必要か</h2>
        <p>海外SaaSが便利でも、最初はChatGPT、Codex、既存の国内ツールで足りることがあります。</p>
      </article>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>まず読む順番</h2>
    </div>
    <div class="route-grid">
      {readingRoutes.map((route) => (
        <a class="tool-route-card" href={route.href}>
          <p class="panel-label">{route.label}</p>
          <h2>{route.title}</h2>
          <p>{route.description}</p>
          <span>読む</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="review-format">
      <p class="panel-label">Review Format</p>
      <h2>今後のレビューで必ず見る項目</h2>
      <div class="format-grid">
        <span>料金と円換算</span>
        <span>無料プラン</span>
        <span>日本語対応</span>
        <span>支払い方法</span>
        <span>解約のしやすさ</span>
        <span>Codexで代替できるか</span>
        <span>向いている人</span>
        <span>向かない人</span>
        <span>TATSUの実験メモ</span>
      </div>
      <p class="button-row">
        <a class="button primary" href="/articles/overseas-saas-before-use/">海外SaaSのチェックリストを読む</a>
        <a class="button" href="/articles/partnerstack-impact-application-checklist/">ASP申請前チェック</a>
      </p>
    </div>
  </section>

  <section class="section compact">
    <div class="section-title">
      <h2>レビュー記事の入口</h2>
    </div>
    <div class="tool-route-grid">
      {reviewRoutes.map((route) => (
        <a class="tool-route-card" href={route.href}>
          <p class="panel-label">Review</p>
          <h2>{route.title}</h2>
          <p>{route.description}</p>
          <span>レビューを読む</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact">
    <div class="lab-panel">
      <div>
        <p class="panel-label">Program Status</p>
        <h2>申請予定の海外SaaSプログラム</h2>
        <p>Webflow、Shopify、beehiiv、Kit、HubSpotなどを、承認状況と確認日つきで管理します。</p>
      </div>
      <p class="button-row">
        <a class="button primary" href="/affiliate-programs/">一覧を見る</a>
        <a class="button" href="/for-partners/">For Partners</a>
      </p>
    </div>
  </section>
</BaseLayout>
