---
import "../styles/global.css";

const {
  title = "ひとり事業ラボ",
  description = "AIと海外SaaSで、ひとり事業を小さく作る実験室"
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="impact-site-verification" value="4c93ea74-e0dc-42a8-8079-de8499b53721" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">ひとり事業ラボ</a>
        <p>AI / SaaS / Solo Business Lab</p>
      </div>
    </header>
    <nav class="site-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/">ホーム</a>
        <a href="/diagnosis/">診断</a>
        <a href="/tools/">ツール比較</a>
        <a href="/overseas-saas/">海外SaaS</a>
        <a href="/newsletter/">ニュースレター</a>
        <a href="/lab-log/">実験ログ</a>
        <a href="/categories/experiment-log/">実験カテゴリ</a>
        <a href="/articles/">記事一覧</a>
        <a href="/about/">このサイトについて</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>ひとり事業ラボ</strong>
        <p>AIと海外SaaSで、ひとり事業を小さく作る実験室</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/operator/">運営者情報</a>
        <a href="/privacy-policy/">プライバシーポリシー</a>
        <a href="/disclaimer/">免責事項</a>
        <a href="/affiliate-disclosure/">アフィリエイト表記</a>
        <a href="/editorial-policy/">編集方針</a>
        <a href="/review-policy/">レビュー基準</a>
        <a href="/affiliate-programs/">紹介プログラム一覧</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </footer>
  </body>
</html>
