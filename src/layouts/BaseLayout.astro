---
import "../styles/global.css";

const {
  title = "ひとり事業ラボ",
  description = "ひとりで小さく事業をつくる実験記録"
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">ひとり事業ラボ</a>
        <p>Written by TATSU</p>
      </div>
    </header>
    <nav class="site-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/">ホーム</a>
        <a href="/categories/experiment-log/">実験ログ</a>
        <a href="/categories/solo-business-tools/">ツール</a>
        <a href="/categories/roadmap/">ロードマップ</a>
        <a href="/articles/">記事一覧</a>
        <a href="/about/">このサイトについて</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>ひとり事業ラボ</strong>
        <p>ひとりで小さく事業をつくる実験記録</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/operator/">運営者情報</a>
        <a href="/privacy-policy/">プライバシーポリシー</a>
        <a href="/disclaimer/">免責事項</a>
        <a href="/affiliate-disclosure/">アフィリエイト表記</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </footer>
  </body>
</html>
